@* Views/Coordinator/Index.cshtml *@
@model IEnumerable<CMCS_ST10445500_PROG6212POE_Final.Models.Claim>
@{
    ViewData["Title"] = "Programme Coordinator - Verify Claims";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">
        <i class="bi bi-check2-all"></i> Programme Coordinator Dashboard
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <strong>No pending claims</strong> — All caught up!
        </div>
    }
    else
    {
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Pending Claims for Verification</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Lecturer</th>
                                <th>Hours Worked</th>
                                <th>Hourly Rate</th>
                                <th>Total Amount</th>
                                <th>Submitted</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td><strong>@claim.Lecturer.Name</strong></td>
                                    <td>@claim.HoursWorked</td>
                                    <td>R @claim.HourlyRate.ToString("F2")</td>
                                    <td><strong class="text-success">R @(claim.HoursWorked* claim.HourlyRate):F2</strong></td>
                                    <td>@claim.SubmittedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(string.IsNullOrEmpty(claim.Notes) ? "— None —" : claim.Notes)</td>
                                    <td class="text-center">
                                        <form asp-action="Verify" method="post" class="d-inline">
                                            <input type="hidden" name="claimId" value="@claim.Id" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                Verify
                                            </button>
                                        </form>
                                        <form asp-action="Reject" method="post" class="d-inline ms-2">
                                            <input type="hidden" name="claimId" value="@claim.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Reject this claim?')">
                                                Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
            Logout
        </a>
    </div>
</div>
